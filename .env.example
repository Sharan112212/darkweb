# SIH26151 Dark-Web Attribution Platform — Environment Template
# Copy to .env and fill in values. NEVER commit .env to git.

# PostgreSQL (Phase 1+)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=darkweb_intel
POSTGRES_USER=darkweb
POSTGRES_PASSWORD=changeme_in_production

# MinIO (Phase 1+)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_in_production
MINIO_BUCKET=raw-artifacts

# Collection mode
COLLECTOR_MODE=fixture_replay
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050

# Neo4j (Phase 6+)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_in_production
